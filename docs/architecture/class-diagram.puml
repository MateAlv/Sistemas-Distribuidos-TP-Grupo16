  class FilterWorker {
    note bottom: one class, CONFIGURATION env drives behavior\nC_USD / C_Q1 / C_DATE / C_Q5
    + start()
  }
  class OutputBatcher
  FilterWorker *-- OutputBatcher

  ' Sum
  class SumWorker
  abstract class SumProcessor
  class Q2SumProcessor
  class Q3SumProcessor
  SumProcessor <|-- Q2SumProcessor
  SumProcessor <|-- Q3SumProcessor
  SumWorker *-- SumProcessor

  ' Aggregator
  class AggregatorWorker
  abstract class AggregatorProcessor
  class Q2AggregatorProcessor
  class Q3AggregatorProcessor
  class Q5AggregatorProcessor
  AggregatorProcessor <|-- Q2AggregatorProcessor
  AggregatorProcessor <|-- Q3AggregatorProcessor
  AggregatorProcessor <|-- Q5AggregatorProcessor
  AggregatorWorker *-- AggregatorProcessor

  ' Joiner
  class JoinerWorker
  abstract class JoinerProcessor
  class Q2JoinerProcessor
  class Q3JoinerProcessor
  class Q5JoinerProcessor
  JoinerProcessor <|-- Q2JoinerProcessor
  JoinerProcessor <|-- Q3JoinerProcessor
  JoinerProcessor <|-- Q5JoinerProcessor
  JoinerWorker *-- JoinerProcessor

  ' Q5 USD filter
  class FilterQ5UsdWorker {
    + start()
  }
  FilterQ5UsdWorker o-- RatesManager

  ' Q2 bank-name joiner
  class BankNameJoinerWorker
  class BankNameJoinerConfig <<dataclass>>
  class ClientState <<dataclass>> {
    + q2_data_count
    + accounts_batch_count
    + q2_expected_total
    + accounts_expected_total
    + bank_names
  }
  BankNameJoinerWorker *-- "many" ClientState
  BankNameJoinerWorker --> BankNameJoinerConfig

  ' Q3 barrier
  class Q3BarrierWorker
  class _ClientState
  class _ClientDiskLog
  Q3BarrierWorker *-- "many" _ClientState
  _ClientState *-- _ClientDiskLog
}

' =============================================================
'  FILE INGESTION
' =============================================================
package "workers.file_splitter / file_ingestor" #FFFBE6 {

  class FileSplitterConfig <<dataclass>>
  class FileKey   <<dataclass>>
  class FileState <<dataclass>> {
    + file_type
    + chunks_received
    + bytes_received
    + batches_emitted
    + data_lines_emitted
  }
  class FileSplitter {
    + _handle_chunk(chunk)
    + _flush_batch(key, state)
    + _send_eof(client_id, total)
  }
  FileSplitter --> FileSplitterConfig
  FileSplitter *-- "many" FileState
  FileState --> FileKey

  class LineSplitter

  class FileIngestorConfig <<dataclass>>
  class FileIngestor {
    + start()
  }
  class LineBatchParser
  class TransactionRowParser
  class TransactionColumnIndexes <<dataclass>>
  FileIngestor --> FileIngestorConfig
  FileIngestor *-- LineBatchParser
  LineBatchParser *-- TransactionRowParser
  TransactionRowParser --> TransactionColumnIndexes
}

' =============================================================
'  Q4 PIPELINE  (scatter-gather)
' =============================================================
package "workers.scatter_gather  (Q4)" #FCE4EC {

  ' source prefilter
  class _SourceState <<dataclass>> {
    + targets : set[Q4AccountId]
    + qualified : bool
    + pending : list[Q4TransactionEdge]
  }
  class Q4FilterWorker {
    + _accept_edge_locked(client_id, edge)
    + _emit_qualified_edge(client_id, edge)
    + _handle_data_packet(client_id, payload)
    + _handle_upstream_eof(client_id, payload)
    + _handle_leader_report(msg)
    + _handle_flush_order(msg)
    + _flush_and_close_client(client_id)
  }
  Q4FilterWorker *-- "many" _SourceState : per source A

  ' per-M aggregator
  class Q4SumWorker {
    + _accept_counted_edges(client_id, payload)
    + _block_plan(in_size, out_size)
    + _emit_client_blocks(client_id)
    + _forward_eof_to_joiners(client_id)
  }

  ' per-block joiner
  class Q4JoinerWorker {
    + _accept_block_edges(client_id, payload)
    + _emit_client_pairs(client_id)
    + _forward_eof_to_aggregators(client_id)
  }

  ' per-pair aggregator
  class Q4AggregatorWorker {
    + _accept_pair_paths(client_id, payload)
    + _emit_qualified_pair(client_id, pair)
    + _forward_eof_to_dedupers(client_id)
  }

  ' per-account deduper
  class Q4DeduperWorker {
    + _accept_accounts(client_id, payload)
    + _emit_and_close_client(client_id)
    + _handle_leader_report(client_id, control)
    + _send_gateway_eof(client_id, total)
  }
}

' === Q4 pipeline dataflow (what each stage emits, conceptually) ===
Q4FilterWorker     ..> Q4CountedEdge   : "emits IN + OUT\nper qualified txn"
Q4SumWorker        ..> Q4BlockJoinEdge : "emits one record per\nA × column / B × row"
Q4JoinerWorker     ..> Q4PairPaths     : "emits one per (A,B)\nwithin a block"
Q4AggregatorWorker ..> Q4AccountId     : "emits accounts of\nqualifying pairs"
Q4DeduperWorker    ..> Q4AccountId     : "emits each\naccount once"

' Workers all consume the input via the middleware abstraction
note as N1
Every worker composes a few middleware instances
(Queue or Exchange) plus serializers. The classes
implement the same lifecycle: start() / handle_sigterm() / close().
end note

