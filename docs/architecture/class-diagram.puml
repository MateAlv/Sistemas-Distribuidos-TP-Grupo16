@startuml class-diagram
title Sistemas Distribuidos TP — Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
hide empty members

' =============================================================
'  MIDDLEWARE
' =============================================================
package "common.middleware" #FAFAFA {

  abstract class MessageMiddleware {
    + send(message, routing_key=None)
    + start_consuming(callback)
    + request_stop_consuming()
    + close()
  }

  abstract class MessageMiddlewareQueue
  abstract class MessageMiddlewareExchange
  abstract class MessageMiddlewareRpcClient
  abstract class MessageMiddlewareRpcServer

  MessageMiddleware <|-- MessageMiddlewareQueue
  MessageMiddleware <|-- MessageMiddlewareExchange

  class _RabbitMQBase {
    - _connection
    - _channel
    - _flow_logger : MessageFlowLogger
    - _record_flow(direction, msg)
  }

  class MessageMiddlewareQueueRabbitMQ
  class MessageMiddlewareExchangeRabbitMQ
  class MessageMiddlewareRpcClientRabbitMQ
  class MessageMiddlewareRpcServerRabbitMQ

  _RabbitMQBase             <|-- MessageMiddlewareQueueRabbitMQ
  MessageMiddlewareQueue    <|-- MessageMiddlewareQueueRabbitMQ
  _RabbitMQBase             <|-- MessageMiddlewareExchangeRabbitMQ
  MessageMiddlewareExchange <|-- MessageMiddlewareExchangeRabbitMQ
  _RabbitMQBase                <|-- MessageMiddlewareRpcClientRabbitMQ
  MessageMiddlewareRpcClient   <|-- MessageMiddlewareRpcClientRabbitMQ
  _RabbitMQBase                <|-- MessageMiddlewareRpcServerRabbitMQ
  MessageMiddlewareRpcServer   <|-- MessageMiddlewareRpcServerRabbitMQ

  class ShardedByClientPublisher {
    + publish(client_id, payload)
  }

  ' Exceptions
  class MessageMiddlewareMessageError       <<exception>>
  class MessageMiddlewareDisconnectedError  <<exception>>
  class MessageMiddlewareCloseError         <<exception>>
  class MessageMiddlewareDeleteError        <<exception>>
}

' =============================================================
'  MESSAGE PROTOCOL — INTERNAL
' =============================================================
package "common.message_protocol.internal" #FAFAFA {

  enum MessageType {
    DATA
    EOF
    PROCESSED_REQUEST
    PROCESSED_ANSWER
    FLUSH_ORDER
    FLUSH_ACK
    AGGREGATED_COUNT
    EOF_RECEIVED
  }

  class InternalProtocol {
    + create_packet(msg_type, client_id, payload)
    + unpack_packet(raw)
  }

  class ControlMessage <<dataclass>> {
    + sender_id : int
    + expected_total : int
    + processed_count : int
  }
  class ControlMessageSerializer

  class LineBatch <<dataclass>> {
    + file_type
    + client_id
    + rel_path
    + batch_id
    + lines
  }
  class LineBatchSerializer

  class TransactionSerializer
  class AggregationSerializer

  ' Q2 / Q3 partial results
  class Q2BankMaxResult        <<dataclass>>
  class Q2BankMaxPartial       <<dataclass>>
  class Q3PaymentFormatPartial <<dataclass>>
  class Q3AverageResult        <<dataclass>>
  class Q2BankMaxResultSerializer
  class Q2BankMaxPartialSerializer
  class Q3PaymentFormatPartialSerializer
  class Q3AverageResultSerializer

  ' Q4 DTOs
  class Q4AccountId <<dataclass>> {
    + bank_id : str
    + account : str
  }
  class Q4TransactionEdge <<dataclass>> {
    + source : Q4AccountId
    + target : Q4AccountId
  }
  class Q4CountedEdge <<dataclass>> {
    + role : int
    + intermediate : Q4AccountId
    + endpoint : Q4AccountId
    + count : int
  }
  class Q4BlockJoinEdge <<dataclass>> {
    + role : int
    + intermediate : Q4AccountId
    + endpoint : Q4AccountId
    + a_bucket : int
    + b_bucket : int
    + count : int
  }
  class Q4PairPaths <<dataclass>> {
    + source : Q4AccountId
    + target : Q4AccountId
    + path_count : int
  }

  class Q4AccountIdSerializer
  class Q4TransactionEdgeSerializer
  class Q4CountedEdgeSerializer
  class Q4BlockJoinEdgeSerializer
  class Q4PairPathsSerializer

  ' Legacy scatter-gather DTOs (kept for the old workers)
  class ScatterGatherRelation <<dataclass>>
  class ScatterGatherResult   <<dataclass>>
  class ScatterGatherRelationSerializer
  class ScatterGatherResultSerializer

  ' Q4 DTO composition
  Q4TransactionEdge "1" *-- "2" Q4AccountId
  Q4CountedEdge     "1" *-- "2" Q4AccountId
  Q4BlockJoinEdge   "1" *-- "2" Q4AccountId
  Q4PairPaths       "1" *-- "2" Q4AccountId

  ' Serializer → DTO
  Q4AccountIdSerializer        ..> Q4AccountId
  Q4TransactionEdgeSerializer  ..> Q4TransactionEdge
  Q4CountedEdgeSerializer      ..> Q4CountedEdge
  Q4BlockJoinEdgeSerializer    ..> Q4BlockJoinEdge
  Q4PairPathsSerializer        ..> Q4PairPaths
  ControlMessageSerializer     ..> ControlMessage
  LineBatchSerializer          ..> LineBatch
  Q2BankMaxResultSerializer        ..> Q2BankMaxResult
  Q2BankMaxPartialSerializer       ..> Q2BankMaxPartial
  Q3PaymentFormatPartialSerializer ..> Q3PaymentFormatPartial
  Q3AverageResultSerializer        ..> Q3AverageResult
  ScatterGatherRelationSerializer  ..> ScatterGatherRelation
  ScatterGatherResultSerializer    ..> ScatterGatherResult

  InternalProtocol ..> MessageType
}

' =============================================================
'  MESSAGE PROTOCOL — EXTERNAL  (client → file_splitter wire format)
' =============================================================
package "common.message_protocol.external" #FAFAFA {
  class FileChunkHeader {
    + client_id
    + file_type
    + rel_path
    + offset
    + payload_size
  }
  class FileChunk
  class FileEof
  FileChunk *-- FileChunkHeader
}

' =============================================================
'  DOMAIN
' =============================================================
package "common.domain" #FAFAFA {
  class Transaction {
    + from_bank
    + from_account
    + to_bank
    + to_account
    + amount
    + currency
    + format
    + date
    + is_in_date_range(start, end)
  }
  class BankAccountMapping <<dataclass>>
}

TransactionSerializer ..> Transaction

' =============================================================
'  COMMON HELPERS
' =============================================================
package "common.* (helpers)" #FAFAFA {
  class BatchBuffer {
    + append(key, payload)
    + flush(predicate)
    + discard(predicate)
  }
  class MessageSummary <<dataclass>> {
    + family
    + msg_type
    + client_id
    + payload_bytes
    + always_log : bool
  }
  class MessageFlowLogger {
    + observe(direction, endpoint, message)
  }
  MessageFlowLogger ..> MessageSummary

  class RatesManager {
    + rate_for(date, currency)
  }
}

' =============================================================
'  CLIENT
' =============================================================
package "client" #F0F8FF {
  class ClientConfig <<dataclass>>
  class InputFile <<dataclass>>
  class ChunkReader {
    + iter_chunks()
  }
  class Sender {
    + send_chunk(chunk)
    + send_eof()
    + iter_result_lines()
  }
  class Client {
    + start()
  }
  Client *-- ChunkReader
  Client *-- Sender
  Client --> ClientConfig
  ChunkReader o-- InputFile
}

' =============================================================
'  GATEWAY
' =============================================================
package "gateway" #F0F8FF {
  class GatewayConfig <<dataclass>>
  class ClientSession <<dataclass>>
  class FileIngestorPublisher
  class Gateway {
    + start()
  }
  Gateway *-- "many" ClientSession
  Gateway *-- FileIngestorPublisher
  Gateway --> GatewayConfig
}

' =============================================================
'  RATES SERVICE
' =============================================================
package "rates_service" #F0F8FF {
  class ExchangeRateService {
    + start()
  }
  ExchangeRateService o-- RatesManager
}

' =============================================================
'  SHARED WORKERS  (used by Q1–Q5 pipelines that are NOT the new Q4)
' =============================================================
